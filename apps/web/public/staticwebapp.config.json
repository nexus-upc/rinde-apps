{
  "navigationFallback": {
    "rewrite": "/index.html",
    "exclude": ["/*.{css,js,png,svg,ico,webp,webmanifest,json,woff2}"]
  },
  "routes": [
    {
      "route": "/config.json",
      "headers": { "Cache-Control": "no-store" }
    }
  ],
  "globalHeaders": {
    "X-Content-Type-Options": "nosniff",
    "Referrer-Policy": "no-referrer",
    "X-Frame-Options": "DENY"
  },
  "mimeTypes": {
    ".webmanifest": "application/manifest+json"
  }
}
